    "josefa-ortiz-dedominguez-99984608": {
      "calle_id": "josefa-ortiz-dedominguez-99984608",
      "nombre_calle": "Josefa Ortiz deDomínguez",
      "mujer": {
        "nombre": "Josefa Ortiz de Domínguez",
        "wikidata_id": "Q462142",
        "wikipedia_titulo": "Josefa Ortiz de Domínguez",
        "tiene_articulo": true,
        "extracto_respaldo": "María Josefa Crescencia Ortiz Téllez-Girón (Valladolid de Michoacán, 8 de septiembre de 1768-Ciudad de México, 2 de marzo de 1829), más conocida como Josefa Ortiz de Domínguez,​​​​ (nombre de casada) fue esposa del corregidor de Querétaro, Miguel Domínguez, por lo que es conocida popularmente como La Corregidora,​ y una insurgente durante la Independencia de México, considerada una de las primeras participantes en la conspiración de Querétaro y pieza clave para el inicio de la lucha que encabezó el cura Miguel Hidalgo y Costilla en Dolores Hidalgo."
      },
      "geo": {
        "lat": 19.357095,
        "lon": -99.169945,
        "osm_way_ids": [
          99984608
        ]
